# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MongoDB Atlas Configuration
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/interview_copilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/interview_copilot_dev

# Security & JWT Configuration
JWT_SECRET=super_secret_jwt_key_at_least_256_bits_long_for_security_compliance_12345
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth2 (Optional for local testing)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Service Configuration (OpenAI or Gemini)
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

